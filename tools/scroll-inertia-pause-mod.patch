From 9ce3abfa3d4c327e0d48ba5b0afa94fda8903807 Mon Sep 17 00:00:00 2001
From: Daytona0306 <y.o.19910306@gmail.com>
Date: Tue, 27 Oct 2026 04:43:31 +0000
Subject: [PATCH] Add pause-mod to suspend inertia while a modifier is held

Ctrl / Cmd + scroll is zoom on most hosts, and they typically count
each wheel report as one zoom step. A coast keeps emitting reports
every tick, so a flick (or a coast still in flight when Ctrl goes
down) keeps zooming long after the ball has stopped.

While any pause-mod bit is held: no new flick is armed, events pass
through untouched, and an in-flight coast stops on the next tick.
Default 0 keeps the existing behaviour.
---
 .../zmk,input-processor-scroll-inertia.yaml   | 13 +++++++++
 src/input_processor_scroll_inertia.c          | 27 ++++++++++++++++++-
 src/scroll_inertia_math.h                     |  1 +
 3 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/dts/bindings/zmk,input-processor-scroll-inertia.yaml b/dts/bindings/zmk,input-processor-scroll-inertia.yaml
index b30fa1c..25470a8 100644
--- a/dts/bindings/zmk,input-processor-scroll-inertia.yaml
+++ b/dts/bindings/zmk,input-processor-scroll-inertia.yaml
@@ -250,6 +250,19 @@ properties:
       such as MOD_RGUI are usually safe; even safer is to bind the
       modifier only inside the scroll layer so it only ever fires
       while you're actively scrolling.
+  pause-mod:
+    type: int
+    default: 0
+    description: |
+      Modifier bitmask that, while held, disables inertia: no new
+      flick is armed, events pass through untouched, and a coast
+      already in flight stops on the next tick.  Set 0 to disable.
+
+      Meant for Ctrl / Cmd + scroll zoom, where hosts typically count
+      each wheel report as one zoom step, so a coast keeps zooming
+      long after the ball has stopped.
+
+      Example: pause-mod = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
 
   # ── Advanced tuning ──────────────────────────────────────
   # These knobs expose the internal state-machine timing.  The
diff --git a/src/input_processor_scroll_inertia.c b/src/input_processor_scroll_inertia.c
index 4fca24a..ad1f105 100644
--- a/src/input_processor_scroll_inertia.c
+++ b/src/input_processor_scroll_inertia.c
@@ -342,6 +342,12 @@ static inline bool unlock_active(const struct scroll_inertia_config *cfg) {
     return (zmk_hid_get_explicit_mods() & cfg->unlock_mod) != 0;
 }
 
+/* Returns true if any of the configured pause-modifier bits are held. */
+static inline bool pause_active(const struct scroll_inertia_config *cfg) {
+    if (cfg->pause_mod == 0) return false;
+    return (zmk_hid_get_explicit_mods() & cfg->pause_mod) != 0;
+}
+
 /* The axis to use right now.  When unlock-mod is held, the configured
  * axis is overridden to AXIS_BOTH so both axes flow freely. */
 static inline int32_t effective_axis(const struct scroll_inertia_config *cfg) {
@@ -935,6 +941,14 @@ static void inertia_tick_handler(struct k_work *work) {
         return;
     }
 
+    /* Pause gate: a coast in flight must not keep emitting once the
+     * pause modifier goes down (e.g. Ctrl, where every wheel report
+     * becomes one zoom step on the host). */
+    if (pause_active(cfg)) {
+        to_idle(data);
+        return;
+    }
+
     /* Duration gate (safety cap only — the natural exponential decay
      * already gives lighter flicks shorter inertia because lower
      * initial velocity reaches the stop threshold sooner). */
@@ -1033,7 +1047,8 @@ static void stop_detect_handler(struct k_work *work) {
         return;
     }
 
-    if (cfg->layer >= 0 && !zmk_keymap_layer_active(cfg->layer)) {
+    if ((cfg->layer >= 0 && !zmk_keymap_layer_active(cfg->layer)) ||
+        pause_active(cfg)) {
         to_idle(data);
         return;
     }
@@ -1074,6 +1089,15 @@ static int scroll_inertia_handle_event(const struct device *dev,
         return ZMK_INPUT_PROC_CONTINUE;
     }
 
+    /* While paused, stay out of the way entirely: drop any gesture
+     * state and pass the event through untouched. */
+    if (pause_active(cfg)) {
+        if (data->state != SS_IDLE) {
+            to_idle(data);
+        }
+        return ZMK_INPUT_PROC_CONTINUE;
+    }
+
     /* Implicit resets from timing (applies regardless of event class
      * so that a long silence followed by any event lands us in IDLE). */
     int64_t now = k_uptime_get();
@@ -1190,6 +1214,7 @@ static struct zmk_input_processor_driver_api scroll_inertia_driver_api = {
         .layer      = DT_INST_PROP(n, layer),                                  \
         .swap_mod   = DT_INST_PROP(n, swap_mod),                              \
         .unlock_mod = DT_INST_PROP(n, unlock_mod),                            \
+        .pause_mod  = DT_INST_PROP(n, pause_mod),                             \
         .min_events         = DT_INST_PROP(n, min_events),                    \
         .decel_samples      = DT_INST_PROP(n, decel_samples),                 \
         .decel_ratio        = DT_INST_PROP(n, decel_ratio),                   \
diff --git a/src/scroll_inertia_math.h b/src/scroll_inertia_math.h
index 2c76d59..988cb3e 100644
--- a/src/scroll_inertia_math.h
+++ b/src/scroll_inertia_math.h
@@ -53,6 +53,7 @@ struct scroll_inertia_config {
     int32_t layer;
     int32_t swap_mod;
     int32_t unlock_mod;
+    int32_t pause_mod;
 
     int32_t min_events;
     int32_t decel_samples;
-- 
2.43.0

